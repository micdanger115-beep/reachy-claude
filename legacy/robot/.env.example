# Ergaenzungen fuer die .env der Reachy-Mini-Conversation-App (auf dem Roboter).

# --- Sprache lokal auf dem PC statt in der HF-Cloud (Datensparsamkeit) ---
HF_REALTIME_CONNECTION_MODE=local
# Mit SSH-Tunnel (empfohlen) zeigt das auf den Tunnel-Eingang auf dem Roboter:
HF_REALTIME_WS_URL=ws://127.0.0.1:8765/v1/realtime
REALTIME_TRANSCRIPTION_LANGUAGE=de

# --- Unser Profil und Tool ---
REACHY_MINI_EXTERNAL_PROFILES_DIRECTORY=/home/pollen/reachy_claude/robot/external_profiles
REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY=/home/pollen/reachy_claude/robot/external_tools
REACHY_MINI_CUSTOM_PROFILE=claude_coder

# --- Verbindung zur claude-bridge auf dem PC ---
CLAUDE_BRIDGE_URL=http://127.0.0.1:8787
CLAUDE_BRIDGE_TOKEN=
# CLAUDE_BRIDGE_TIMEOUT_S=960
# CLAUDE_BRIDGE_CA_FILE=/home/pollen/reachy_claude/bridge-cert.pem   (nur bei HTTPS)
