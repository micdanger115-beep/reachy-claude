 # Configuration constants
 CONTROL_LOOP_FREQUENCY_HZ = 60.0  # Hz - Target frequency for the movement control loop
 
+# Attentive listening motion (small on purpose: it must read as "alive", not as a gesture)
+LISTENING_FADE_S = 0.4
+LISTENING_ANTENNA_SWAY_RAD = 0.12  # ~7 deg
+LISTENING_ANTENNA_SWAY_HZ = 0.7
+LISTENING_HEAD_ROLL_DEG = 6.0
+LISTENING_HEAD_NOD_DEG = 2.0
+LISTENING_HEAD_NOD_HZ = 0.35
+
 # Type definitions
 FullBodyPose = Tuple[NDArray[np.float32], Tuple[float, float], float]  # (head_pose_4x4, antennas, body_yaw)
 
 
+def listening_motion(elapsed: float, weight: float) -> Tuple[float, float, Tuple[float, float]]:
+    """Return (head roll deg, head pitch deg, antenna offsets rad) for attentive listening.
+
+    ``weight`` (0..1) fades the whole motion in and out so it never jumps.
+    """
+    ease = min(1.0, max(0.0, weight))
+    ease = ease * ease * (3.0 - 2.0 * ease)  # smoothstep
+    phase = 2.0 * math.pi * LISTENING_ANTENNA_SWAY_HZ * elapsed
+    # Antennas sway out of phase so they look like they are "tuning in".
+    antennas = (
+        ease * LISTENING_ANTENNA_SWAY_RAD * math.sin(phase),
+        ease * LISTENING_ANTENNA_SWAY_RAD * math.sin(phase + math.pi / 2.0),
+    )
+    nod = LISTENING_HEAD_NOD_DEG * math.sin(2.0 * math.pi * LISTENING_HEAD_NOD_HZ * elapsed)
+    return ease * LISTENING_HEAD_ROLL_DEG, ease * nod, antennas
+
+
