# claude-bridge – Konfiguration (Vorlage). Kopieren nach .env und anpassen.
# WICHTIG: .env NIEMALS committen und NICHT in den Claude-Arbeitsordner legen.

# Gemeinsames Geheimnis mit dem Roboter (min. 32 Zeichen). Erzeugen mit:
#   claude-bridge gen-token
CLAUDE_BRIDGE_TOKEN=

# Netzwerk – empfohlen ist der SSH-Tunnel (siehe README): dann nur Loopback.
CLAUDE_BRIDGE_HOST=127.0.0.1
CLAUDE_BRIDGE_PORT=8787
CLAUDE_BRIDGE_ALLOWED_CLIENTS=127.0.0.1
# Variante "direkt im WLAN" stattdessen:
#   CLAUDE_BRIDGE_HOST=192.168.1.20          (LAN-IP des PCs)
#   CLAUDE_BRIDGE_ALLOWED_CLIENTS=192.168.1.30 (IP von Reachy)

# Projektordner, in dem Claude arbeiten darf (am besten ein Git-Repository).
CLAUDE_BRIDGE_WORKDIR=C:\Users\DEINNAME\projekte\mein-projekt

# Rechte: read = nur lesen/erklaeren, edit = zusaetzlich Dateien bearbeiten (keine Shell, kein Web)
CLAUDE_BRIDGE_PERMISSION_LEVEL=edit

# Optional
# CLAUDE_BRIDGE_CLAUDE_BIN=C:\Users\DEINNAME\.local\bin\claude.exe
# CLAUDE_BRIDGE_TIMEOUT_S=900
# CLAUDE_BRIDGE_MAX_TURNS=30
# CLAUDE_BRIDGE_MAX_PROMPT_CHARS=4000
# CLAUDE_BRIDGE_SPOKEN_MAX_CHARS=900
# CLAUDE_BRIDGE_RATE_LIMIT_PER_MIN=10
# CLAUDE_BRIDGE_TRANSCRIPT_DIR=transcripts   (off = keine Mitschrift)
# CLAUDE_BRIDGE_LOG_PROMPTS=false
# CLAUDE_BRIDGE_TLS_CERT=cert.pem            (nur Variante "direkt im WLAN")
# CLAUDE_BRIDGE_TLS_KEY=key.pem
